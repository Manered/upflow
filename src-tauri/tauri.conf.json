{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "upflow",
  "version": "1.0.0",
  "identifier": "dev.manere.upflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "upflow",
        "width": 700,
        "height": 650,
        "minWidth": 420,
        "minHeight": 430,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#111111"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
